[
  { "id": "kepler-laws", "front": "Kepler’s three laws?", "back": "1. Elliptical orbits, Sun at a focus. 2. Equal areas in equal times. 3. $T^2 \\propto r^3$.", "concept": "Kepler’s laws" },
  { "id": "newton-grav", "front": "Newton’s law of gravitation?", "back": "$F = Gm_1m_2/r^2$, G = 6.67 × 10⁻¹¹ N m² kg⁻².", "concept": "Newton’s law of gravitation" },
  { "id": "g-def", "front": "Define gravitational field strength.", "back": "Force per unit mass on a small test mass: $g = F/m = GM/r^2$.", "concept": "Gravitational field strength" },
