  { "id": "binom-cond-card", "front": "Conditions for a binomial model?", "back": "Fixed n, independent trials, two outcomes, constant p.", "concept": "Conditions", "kind": "condition" },
  { "id": "binom-formula-card", "front": "Binomial probability formula?", "back": "$P(X = r) = \\binom nr p^r(1 - p)^{n - r}$", "concept": "Binomial probability", "kind": "formula" },
  { "id": "binom-mv-card", "front": "Mean and variance of B(n, p)?", "back": "$np$ and $np(1 - p)$.", "concept": "Mean and variance", "kind": "formula" },
  { "id": "binom-def", "front": "What does $X \\sim B(n, p)$ count?", "back": "The number of successes in $n$ independent trials, each with the same probability $p$ of success.", "concept": "Conditions", "kind": "definition" },
  { "id": "binom-pdf-example", "front": "$X \\sim B(10, 0.3)$. Find $P(X = 2)$.", "back": "$\\binom{10}2(0.3)^2(0.7)^8 \\approx 0.233$.", "concept": "Binomial probability", "kind": "application" },
  { "id": "binom-geq", "front": "How do you find $P(X \\ge 3)$ with a GDC?", "back": "$1 - P(X \\le 2)$ using binomial cdf. For $B(10, 0.3)$: $1 - 0.383 = 0.617$.", "concept": "Binomial probability", "kind": "method" },
  { "id": "binom-ineq-words", "front": "Convert to $\\le$ form: $P(X < 5)$, $P(X > 5)$, \"at most 5\", \"at least 5\".", "back": "$P(X \\le 4)$; $1 - P(X \\le 5)$; $P(X \\le 5)$; $1 - P(X \\le 4)$.", "concept": "Binomial probability", "kind": "method" },
  { "id": "binom-mv-example", "front": "Mean, variance and SD of $B(20, 0.4)$?", "back": "Mean 8, variance $20(0.4)(0.6) = 4.8$, SD $\\approx 2.19$.", "concept": "Mean and variance", "kind": "application" },
  { "id": "binom-without-replacement", "front": "Drawing 5 cards without replacement and counting hearts: binomial?", "back": "No — $p$ changes after each draw and trials are not independent. (With replacement it would be.)", "concept": "Conditions", "kind": "misconception" },
  { "id": "binom-pdf-cdf", "front": "Binomial pdf vs cdf on a GDC?", "back": "pdf gives $P(X = r)$; cdf gives $P(X \\le r)$.", "concept": "Binomial probability", "kind": "distinction" },
  { "id": "binom-find-n", "front": "Smallest $n$ so that P(at least one success) $> 0.95$ with $p = 0.1$?", "back": "$1 - 0.9^n > 0.95 \\Rightarrow 0.9^n < 0.05 \\Rightarrow n > \\frac{\\ln0.05}{\\ln0.9} \\approx 28.4$, so $n = 29$.", "concept": "Binomial probability", "kind": "method" }
