  { "id": "polar-mult-example", "front": "(HL) Simplify $\\left(2\\,\\text{cis}\\frac\\pi3\\right)\\left(3\\,\\text{cis}\\frac\\pi6\\right)$.", "back": "$6\\,\\text{cis}\\frac\\pi2 = 6i$.", "concept": "Products", "kind": "application" },
