[
  { "id": "sinf-card", "front": "Sum to infinity and its condition?", "back": "$S_\\infty = \\dfrac{u_1}{1 - r}$, valid when $|r| < 1$.", "concept": "Sum to infinity", "kind": "condition" },
  { "id": "recur-card", "front": "Recurring decimal as a fraction?", "back": "Treat as geometric series: e.g. $0.\\overline{ab} = \\dfrac{0.ab}{0.99}$.", "concept": "Recurring decimals", "kind": "method" },
  { "id": "sinf-why", "front": "Why does $S_n \\to \\dfrac{u_1}{1 - r}$ when $|r| < 1$?", "back": "$S_n = \\dfrac{u_1(1 - r^n)}{1 - r}$ and $r^n \\to 0$ as $n \\to \\infty$ when $|r| < 1$.", "concept": "Sum to infinity", "kind": "derivation" },
  { "id": "sinf-diverge", "front": "What happens to a geometric series with $|r| \\ge 1$?", "back": "It diverges: for $|r| > 1$ the terms grow; $r = 1$ gives $S_n = nu_1$; $r = -1$ makes $S_n$ oscillate. No $S_\\infty$ exists.", "concept": "Sum to infinity", "kind": "concept" },
  { "id": "sinf-example", "front": "Find $12 + 6 + 3 + \\ldots$", "back": "$r = \\frac12$, so $S_\\infty = \\dfrac{12}{1 - \\frac12} = 24$.", "concept": "Sum to infinity", "kind": "application" },
  { "id": "sinf-negative-r", "front": "Find $8 - 4 + 2 - 1 + \\ldots$", "back": "$r = -\\frac12$ ($|r| < 1$), so $S_\\infty = \\dfrac{8}{1 + \\frac12} = \\dfrac{16}3$.", "concept": "Sum to infinity", "kind": "application" },
  { "id": "sinf-find-r", "front": "A geometric series has $u_1 = 5$ and $S_\\infty = 20$. Find $r$.", "back": "$\\dfrac5{1 - r} = 20 \\Rightarrow 1 - r = \\frac14 \\Rightarrow r = \\frac34$.", "concept": "Sum to infinity", "kind": "application" },
  { "id": "recur-example", "front": "Write $0.\\overline{36}$ as a fraction.", "back": "$0.36 + 0.0036 + \\ldots$: $u_1 = 0.36$, $r = 0.01$, so $\\dfrac{0.36}{0.99} = \\dfrac{36}{99} = \\dfrac4{11}$.", "concept": "Recurring decimals", "kind": "application" },
  { "id": "sinf-x-condition", "front": "For which $x$ does $1 + 2x + 4x^2 + \\ldots$ converge, and to what?", "back": "$r = 2x$; need $|2x| < 1$, i.e. $-\\frac12 < x < \\frac12$. Then $S_\\infty = \\dfrac1{1 - 2x}$.", "concept": "Conditions on x", "kind": "method" },
  { "id": "sinf-remainder", "front": "How far is $S_n$ from $S_\\infty$?", "back": "$S_\\infty - S_n = \\dfrac{u_1r^n}{1 - r}$ — use it to find $n$ so that $S_n$ is within a given amount of $S_\\infty$.", "concept": "Sum to infinity", "kind": "formula" },
  { "id": "sinf-misuse", "front": "$2 + 6 + 18 + \\ldots$: is $S_\\infty = \\dfrac2{1 - 3} = -1$?", "back": "No — $r = 3$, so the series diverges and has no sum to infinity. Always check $|r| < 1$ first.", "concept": "Sum to infinity", "kind": "misconception" }
]
