  { "id": "tan-identity", "front": "$\\tan\\theta$ in terms of $\\sin$ and $\\cos$?", "back": "$\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta}$, $\\cos\\theta \\ne 0$.", "concept": "Pythagorean identity", "kind": "formula" },
  { "id": "quadrant-example", "front": "$\\sin\\theta = \\frac35$ and $\\theta$ is obtuse. Find $\\cos\\theta$ and $\\tan\\theta$.", "back": "$\\cos^2\\theta = 1 - \\frac9{25} = \\frac{16}{25}$, negative in Q2: $\\cos\\theta = -\\frac45$, $\\tan\\theta = -\\frac34$.", "concept": "Pythagorean identity", "kind": "application" },
  { "id": "sqrt-sign-mistake", "front": "From $\\cos^2\\theta = \\frac{16}{25}$, is $\\cos\\theta = \\frac45$?", "back": "Only if $\\theta$ is in Q1 or Q4. Take $\\pm$ and choose the sign from the quadrant.", "concept": "Pythagorean identity", "kind": "misconception" },
  { "id": "double-example", "front": "$\\sin\\theta = \\frac35$, $\\theta$ acute. Find $\\sin2\\theta$ and $\\cos2\\theta$.", "back": "$\\cos\\theta = \\frac45$: $\\sin2\\theta = 2\\cdot\\frac35\\cdot\\frac45 = \\frac{24}{25}$; $\\cos2\\theta = 1 - 2\\cdot\\frac9{25} = \\frac7{25}$.", "concept": "Double angle", "kind": "application" },
  { "id": "power-reduction", "front": "$\\cos^2\\theta$ and $\\sin^2\\theta$ in terms of $\\cos2\\theta$?", "back": "$\\cos^2\\theta = \\dfrac{1 + \\cos2\\theta}2$, $\\sin^2\\theta = \\dfrac{1 - \\cos2\\theta}2$ (needed to integrate them).", "concept": "Double angle", "kind": "formula" },
  { "id": "sin2-mistake", "front": "Is $\\sin2\\theta = 2\\sin\\theta$?", "back": "No — $\\sin2\\theta = 2\\sin\\theta\\cos\\theta$. E.g. $\\theta = \\frac\\pi2$: $\\sin\\pi = 0 \\ne 2$.", "concept": "Double angle", "kind": "misconception" },
  { "id": "choose-cos2", "front": "Which form of $\\cos2\\theta$ should you use?", "back": "Match the rest of the expression: $1 - 2\\sin^2\\theta$ if everything else is in $\\sin$, $2\\cos^2\\theta - 1$ if in $\\cos$.", "concept": "Double angle", "kind": "method" },
  { "id": "identity-proof-example", "front": "Prove $(\\sin\\theta + \\cos\\theta)^2 \\equiv 1 + \\sin2\\theta$.", "back": "LHS $= \\sin^2\\theta + \\cos^2\\theta + 2\\sin\\theta\\cos\\theta = 1 + \\sin2\\theta =$ RHS.", "concept": "Double angle", "kind": "application" },
  { "id": "identity-def", "front": "Trigonometric identity?", "back": "An equation involving trig functions true for every angle where both sides are defined (e.g. $\\sin^2\\theta + \\cos^2\\theta \\equiv 1$).", "concept": "Pythagorean identity", "kind": "definition" },
