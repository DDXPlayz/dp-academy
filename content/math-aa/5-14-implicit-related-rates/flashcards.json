[
  { "id": "implicit-card", "front": "(HL) Differentiating $y^n$ implicitly?", "back": "$ny^{n-1}\\frac{dy}{dx}$", "concept": "Implicit differentiation", "kind": "formula" },
  { "id": "related-card", "front": "(HL) Related rates method?", "back": "Find an equation linking variables, differentiate w.r.t. t, then substitute values.", "concept": "Related rates", "kind": "method" },
  { "id": "implicit-def", "front": "(HL) Implicit relation?", "back": "A relation between $x$ and $y$ not written as $y = f(x)$, e.g. $x^2 + y^2 = 25$; differentiate treating $y$ as a function of $x$.", "concept": "Implicit differentiation", "kind": "definition" },
  { "id": "circle-example", "front": "(HL) Gradient of $x^2 + y^2 = 25$ at $(3, 4)$?", "back": "$2x + 2y\\frac{dy}{dx} = 0 \\Rightarrow \\frac{dy}{dx} = -\\frac xy = -\\frac34$.", "concept": "Implicit differentiation", "kind": "application" },
  { "id": "xy-product", "front": "(HL) $\\dfrac{d}{dx}(xy)$ and $\\dfrac{d}{dx}(e^y)$?", "back": "Product rule: $y + x\\dfrac{dy}{dx}$. Chain rule: $e^y\\dfrac{dy}{dx}$.", "concept": "Implicit differentiation", "kind": "formula" },
  { "id": "implicit-example", "front": "(HL) Find $\\frac{dy}{dx}$ for $x^2 + xy + y^2 = 7$.", "back": "$2x + y + x\\frac{dy}{dx} + 2y\\frac{dy}{dx} = 0 \\Rightarrow \\frac{dy}{dx} = -\\dfrac{2x + y}{x + 2y}$.", "concept": "Implicit differentiation", "kind": "application" },
  { "id": "implicit-mistake", "front": "(HL) Is $\\dfrac{d}{dx}(y^2) = 2y$?", "back": "No — $2y\\dfrac{dy}{dx}$ (chain rule, since $y$ depends on $x$).", "concept": "Implicit differentiation", "kind": "misconception" },
  { "id": "horiz-vert-tangent", "front": "(HL) Horizontal and vertical tangents of an implicit curve?", "back": "With $\\frac{dy}{dx} = \\frac PQ$: horizontal where $P = 0$ (and $Q \\ne 0$), vertical where $Q = 0$ (and $P \\ne 0$); substitute back into the curve.", "concept": "Implicit differentiation", "kind": "method" },
  { "id": "sphere-rate", "front": "(HL) A sphere's radius grows at 2 cm s$^{-1}$. Rate of change of volume when $r = 5$?", "back": "$\\frac{dV}{dt} = 4\\pi r^2\\frac{dr}{dt} = 4\\pi(25)(2) = 200\\pi$ cm$^3$ s$^{-1}$.", "concept": "Related rates", "kind": "application" },
  { "id": "circle-rate", "front": "(HL) A circle's area increases at 10 cm$^2$ s$^{-1}$. Find $\\frac{dr}{dt}$ when $r = 5$.", "back": "$\\frac{dA}{dt} = 2\\pi r\\frac{dr}{dt} \\Rightarrow 10 = 10\\pi\\frac{dr}{dt} \\Rightarrow \\frac{dr}{dt} = \\frac1\\pi$ cm s$^{-1}$.", "concept": "Related rates", "kind": "application" },
  { "id": "related-mistake", "front": "(HL) Related rates: substitute the given value of $r$ before differentiating?", "back": "No — that turns a variable into a constant. Differentiate the general relation first, then substitute.", "concept": "Related rates", "kind": "misconception" }
]
