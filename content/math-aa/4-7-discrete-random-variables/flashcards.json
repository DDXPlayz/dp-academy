[
  { "id": "sum1-card", "front": "Condition for a probability distribution?", "back": "All $P \\ge 0$ and $\\sum P(X = x) = 1$.", "concept": "Probability distributions", "kind": "condition" },
  { "id": "ex-card", "front": "Expected value of a discrete RV?", "back": "$E(X) = \\sum xP(X = x)$", "concept": "Expected value", "kind": "formula" },
  { "id": "fair-card", "front": "Fair game?", "back": "Expected gain (winnings − cost) is 0.", "concept": "Fair games", "kind": "definition" },
  { "id": "drv-def", "front": "Discrete random variable?", "back": "A variable taking countable values, each with a probability; its distribution can be a table or a formula.", "concept": "Probability distributions", "kind": "definition" },
  { "id": "unknown-k", "front": "$P(X = x)$ is $0.1, 0.3, k, 2k$ for $x = 1, 2, 3, 4$. Find $k$.", "back": "$0.4 + 3k = 1 \\Rightarrow k = 0.2$.", "concept": "Probability distributions", "kind": "application" },
  { "id": "formula-dist", "front": "$P(X = x) = kx$ for $x = 1, 2, 3, 4$. Find $k$.", "back": "$k(1 + 2 + 3 + 4) = 1 \\Rightarrow k = \\frac1{10}$.", "concept": "Probability distributions", "kind": "application" },
  { "id": "ex-example", "front": "$X = 1, 2, 3$ with probabilities $0.2, 0.5, 0.3$. Find $E(X)$.", "back": "$0.2 + 1.0 + 0.9 = 2.1$.", "concept": "Expected value", "kind": "application" },
  { "id": "ex-mistake", "front": "Must $E(X)$ be a value $X$ can take?", "back": "No — it is a long-run average (e.g. 3.5 for a die).", "concept": "Expected value", "kind": "misconception" },
  { "id": "fair-example", "front": "Pay \\$2 to play; win \\$10 with probability 0.2. Is the game fair?", "back": "Expected gain $= 0.2\\times10 - 2 = 0$, so yes.", "concept": "Fair games", "kind": "application" },
  { "id": "gain-method", "front": "How do you find the expected gain from a game?", "back": "Let $X$ = net gain (prize minus cost) for each outcome, then $E(X) = \\sum xP(X = x)$. Negative: player loses on average.", "concept": "Fair games", "kind": "method" },
  { "id": "var-discrete", "front": "(HL) Variance of a discrete random variable?", "back": "$\\text{Var}(X) = \\sum x^2P(X = x) - [E(X)]^2$.", "concept": "Variance", "kind": "formula" },
  { "id": "var-discrete-example", "front": "(HL) Variance of $X = 1, 2, 3$ with probabilities $0.2, 0.5, 0.3$?", "back": "$E(X^2) = 0.2 + 2 + 2.7 = 4.9$; $\\text{Var}(X) = 4.9 - 2.1^2 = 0.49$.", "concept": "Variance", "kind": "application" }
]
